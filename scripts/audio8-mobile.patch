@@ -0,0 +1,22 @@
+#pragma once
+#include <cstdint>
+#include <stdexcept>
+
+namespace engine::models::audio8_tts {
+// Synchronous per-calling-thread controls, never shared between sessions.
+struct MobileOptions {
+    bool compact_head = false;
+    bool retain_graphs = false;
+    int fast_threads = 0;
+    int slow_threads = 0;
+    int (*cancelled)(void *) = nullptr;
+    void * user = nullptr;
+    int64_t semantic_start = 0, semantic_end = -1, eos = -1;
+};
+inline thread_local MobileOptions mobile_options;
+inline int mobile_slow_threads(int fallback) { return mobile_options.slow_threads > 0 ? mobile_options.slow_threads : fallback; }
+inline void mobile_check_cancelled() {
+    if (mobile_options.cancelled && mobile_options.cancelled(mobile_options.user))
+        throw std::runtime_error("Audio8 synthesis cancelled");
+}
+}
diff --git a/include/engine/community_models/audio8_tts/mobile_math.h b/include/engine/community_models/audio8_tts/mobile_math.h
new file mode 100644
index 0000000..9dddbef
--- /dev/null
+++ b/include/engine/community_models/audio8_tts/mobile_math.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <ggml.h>
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace engine::models::audio8_tts {
+inline ggml_tensor * mobile_head_rows(ggml_context * ctx, ggml_tensor * w, int64_t first, int64_t rows) {
+    if (first < 0 || rows <= 0 || first > w->ne[1] - rows)
+        throw std::runtime_error("Audio8 compact head row range invalid");
+    return ggml_view_2d(ctx, w, w->ne[0], rows, w->nb[1], static_cast<size_t>(first) * w->nb[1]);
+}
+inline std::vector<float> mobile_expand_logits(const std::vector<float> & values,
+    int64_t vocab, int64_t begin, int64_t end, int64_t eos) {
+    if (values.size() == static_cast<size_t>(vocab)) return values;
+    if (begin < 0 || end < begin || end >= vocab || eos < 0 || eos >= vocab ||
+        (eos >= begin && eos <= end) || values.size() != static_cast<size_t>(end - begin + 2))
+        throw std::runtime_error("Audio8 compact output shape mismatch");
+    std::vector<float> full(static_cast<size_t>(vocab), -std::numeric_limits<float>::infinity());
+    std::copy_n(values.begin(), end - begin + 1, full.begin() + begin);
+    full[static_cast<size_t>(eos)] = values.back();
+    return full;
+}
+}
