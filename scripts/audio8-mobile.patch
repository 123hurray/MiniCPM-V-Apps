+#pragma once
+#include <cstdint>
+#include <stdexcept>
+
+namespace engine::models::audio8_tts {
+// Synchronous per-calling-thread controls, never shared between sessions.
+struct MobileOptions {
+    void (*progress)(const char *) = nullptr;
+    int (*forward)(void *, int, const int32_t *, int64_t, int64_t, int64_t, int,
+                   const float *, float *, int64_t, float *, int64_t) = nullptr;
+    const char * (*forward_error)(void *) = nullptr;
+    void * forward_user = nullptr;
+    int (*codec_decode)(void *, const int32_t *, int64_t, int64_t, const float **, int64_t *) = nullptr;
+    const char * (*codec_error)(void *) = nullptr;
+    void * codec_user = nullptr;
+    bool compact_head = false;
+    bool retain_graphs = false;
+    int fast_threads = 0;
+    int slow_threads = 0;
+    int codec_threads = 0;
+    bool codec_optimized = false;
+    int (*cancelled)(void *) = nullptr;
+    void * user = nullptr;
+    int64_t semantic_start = 0, semantic_end = -1, eos = -1;
+};
+inline thread_local MobileOptions mobile_options;
+inline int mobile_slow_threads(int fallback) { return mobile_options.slow_threads > 0 ? mobile_options.slow_threads : fallback; }
+inline int mobile_codec_threads(int fallback) { return mobile_options.codec_threads > 0 ? mobile_options.codec_threads : mobile_slow_threads(fallback); }
+inline void mobile_check_cancelled() {
+    if (mobile_options.cancelled && mobile_options.cancelled(mobile_options.user))
+        throw std::runtime_error("Audio8 synthesis cancelled");
+}
+}
diff --git a/include/engine/community_models/audio8_tts/mobile_codec.h b/include/engine/community_models/audio8_tts/mobile_codec.h
new file mode 100644
index 00000000..e868dbce
--- /dev/null
+++ b/include/engine/community_models/audio8_tts/mobile_codec.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <ggml.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <stdexcept>
+
+namespace engine::models::audio8_tts {
+inline void mobile_col2im(ggml_tensor * dst,int ith,int nth,void * userdata) {
+    const auto * columns=dst->src[0];
+    const int stride=static_cast<int>(reinterpret_cast<intptr_t>(userdata));
+    const int64_t channels=dst->ne[1],kernel=columns->ne[0]/channels,length=columns->ne[1];
+    const auto * source=static_cast<const float *>(columns->data);
+    auto * out=static_cast<float *>(dst->data);
+    const int64_t count=ggml_nelements(dst),begin=count*ith/nth,end=count*(ith+1)/nth;
+    for(int64_t index=begin;index<end;++index) {
+        const int64_t t=index%dst->ne[0],c=index/dst->ne[0];
+        const int64_t first=std::max<int64_t>(0,(t-kernel+stride)/stride),last=std::min<int64_t>(length-1,t/stride);
+        float value=0;
+        for(int64_t frame=first;frame<=last;++frame)
+            value+=source[frame*columns->ne[0]+c*kernel+t-frame*stride];
+        out[index]=value;
+    }
+}
+// Exact F32 weights/inputs, same kernel orientation and overlap order as baseline.
+// A blocked GEMM replaces thousands of independent small dot products.
+inline ggml_tensor * mobile_conv_transpose(ggml_context * ctx,ggml_tensor * weight,ggml_tensor * input,int stride) {
+    if(stride<1 || (weight->type!=GGML_TYPE_F32 && weight->type!=GGML_TYPE_F16) || input->type!=GGML_TYPE_F32 ||
+       !ggml_is_contiguous(weight) || !ggml_is_contiguous(input) || weight->ne[2]!=input->ne[1] || input->ne[2]!=1)
+        throw std::runtime_error("CPU codec GEMM transpose contract mismatch");
+    auto * matrix=ggml_reshape_2d(ctx,ggml_cont(ctx,ggml_permute(ctx,weight,1,2,0,3)),weight->ne[2],weight->ne[0]*weight->ne[1]);
+    auto * x=ggml_cont(ctx,ggml_transpose(ctx,input));
+    auto * columns=ggml_mul_mat(ctx,matrix,x);
+    ggml_mul_mat_set_prec(columns,GGML_PREC_F32);
+    ggml_tensor * args[]={columns};
+    return ggml_custom_4d(ctx,GGML_TYPE_F32,(input->ne[0]-1)*stride+weight->ne[0],weight->ne[1],1,1,
+        args,1,mobile_col2im,GGML_N_TASKS_MAX,reinterpret_cast<void *>(static_cast<intptr_t>(stride)));
+}
+inline void mobile_snake_kernel(ggml_tensor * dst,const ggml_tensor * x,const ggml_tensor * alpha,int ith,int nth,void *) {
+    const auto * input=static_cast<const float *>(x->data);const auto * scales=static_cast<const float *>(alpha->data);
+    auto * out=static_cast<float *>(dst->data);const int64_t count=ggml_nelements(x);
+    const int64_t end=count*(ith+1)/nth;
+    int64_t i=count*ith/nth;
+    while(i<end) {
+        const int64_t channel=i/x->ne[0];
+        const int64_t stop=std::min(end,(channel+1)*x->ne[0]);
+        const float a=scales[channel%x->ne[1]];
+        for(;i<stop;++i) {
+            const float sine=std::sin(a*input[i]);
+            out[i]=input[i]+(sine*sine)/a;
+        }
+    }
+}
+inline ggml_tensor * mobile_snake(ggml_context * ctx,ggml_tensor * x,ggml_tensor * alpha) {
+    if(x->type!=GGML_TYPE_F32 || alpha->type!=GGML_TYPE_F32 || !ggml_is_contiguous(x) ||
+       !ggml_is_contiguous(alpha) || ggml_nelements(alpha)!=x->ne[1])
+        throw std::runtime_error("CPU codec fused snake contract mismatch");
+    return ggml_map_custom2(ctx,x,alpha,mobile_snake_kernel,GGML_N_TASKS_MAX,nullptr);
+}
+}
diff --git a/include/engine/community_models/audio8_tts/mobile_math.h b/include/engine/community_models/audio8_tts/mobile_math.h
new file mode 100644
index 00000000..9dddbefb
--- /dev/null
+++ b/include/engine/community_models/audio8_tts/mobile_math.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <ggml.h>
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace engine::models::audio8_tts {
+inline ggml_tensor * mobile_head_rows(ggml_context * ctx, ggml_tensor * w, int64_t first, int64_t rows) {
+    if (first < 0 || rows <= 0 || first > w->ne[1] - rows)
+        throw std::runtime_error("Audio8 compact head row range invalid");
+    return ggml_view_2d(ctx, w, w->ne[0], rows, w->nb[1], static_cast<size_t>(first) * w->nb[1]);
+}
+inline std::vector<float> mobile_expand_logits(const std::vector<float> & values,
+    int64_t vocab, int64_t begin, int64_t end, int64_t eos) {
+    if (values.size() == static_cast<size_t>(vocab)) return values;
+    if (begin < 0 || end < begin || end >= vocab || eos < 0 || eos >= vocab ||
+        (eos >= begin && eos <= end) || values.size() != static_cast<size_t>(end - begin + 2))
+        throw std::runtime_error("Audio8 compact output shape mismatch");
+    std::vector<float> full(static_cast<size_t>(vocab), -std::numeric_limits<float>::infinity());
+    std::copy_n(values.begin(), end - begin + 1, full.begin() + begin);
+    full[static_cast<size_t>(eos)] = values.back();
+    return full;
+}
+}
diff --git a/include/engine/community_models/audio8_tts/mobile_threadpool.h b/include/engine/community_models/audio8_tts/mobile_threadpool.h
new file mode 100644
index 00000000..a827db57
--- /dev/null
+++ b/include/engine/community_models/audio8_tts/mobile_threadpool.h
@@ -0,0 +1,33 @@
+#pragma once
+#include <ggml-cpu.h>
+#include <stdexcept>
+namespace engine::models::audio8_tts {
+// Synchronous request lifetime; detach before freeing. No global backend-keyed state.
+class MobileThreadpoolScope {
+    ggml_backend_t backends[2]{};
+    ggml_threadpool_t pools[2]{};
+public:
+    MobileThreadpoolScope(ggml_backend_t slow,ggml_backend_t fast) {
+        try {
+            for(int i=0;i<2;++i) {
+                auto backend=i==0?slow:fast;
+                if(!backend || (i==1 && fast==slow) || !ggml_backend_is_cpu(backend))continue;
+                auto params=ggml_threadpool_params_default(8);
+                params.poll=0; // Park inactive workers; do not busy-spin between AR steps.
+                pools[i]=ggml_threadpool_new(&params);
+                if(!pools[i])throw std::runtime_error("Cannot create AR CPU threadpool");
+                backends[i]=backend;ggml_backend_cpu_set_threadpool(backend,pools[i]);
+            }
+        } catch(...) {clear();throw;}
+    }
+    void clear() noexcept {
+        for(int i=0;i<2;++i)if(pools[i]) {
+            ggml_backend_cpu_set_threadpool(backends[i],nullptr);
+            ggml_threadpool_free(pools[i]);pools[i]=nullptr;backends[i]=nullptr;
+        }
+    }
+    ~MobileThreadpoolScope(){clear();}
+    MobileThreadpoolScope(const MobileThreadpoolScope &)=delete;
+    MobileThreadpoolScope & operator=(const MobileThreadpoolScope &)=delete;
+};
+}
