+core::TensorValue mobile_output_head(core::ModuleBuildContext & ctx,
+    const core::TensorValue & input, const modules::LinearWeights & weights,
+    const modules::CausalDecoderConfig & config) {
+    const auto & m = mobile_options;
+    auto * w = weights.weight.tensor;
+    const int64_t count = m.semantic_end - m.semantic_start + 1;
+    if (!m.compact_head || config.use_lm_head_bias || config.logits_size < 100000 ||
+        m.semantic_start < 0 || count != 4096 || m.semantic_end >= config.logits_size ||
+        m.eos < 0 || m.eos >= config.logits_size ||
+        (m.eos >= m.semantic_start && m.eos <= m.semantic_end) ||
+        w->ne[0] != config.stack.hidden_size || w->ne[1] != config.logits_size) {
+        return modules::LinearModule({config.stack.hidden_size, config.logits_size,
+            config.use_lm_head_bias, config.lm_head_precision}).build(ctx, input, weights);
+    }
+    // Views select rows, not columns: Q8 blocks and original token IDs stay unchanged.
+    auto project = [&](int64_t first, int64_t rows) {
+        auto * view = mobile_head_rows(ctx.ggml, w, first, rows);
+        modules::LinearWeights slice{core::wrap_tensor(view,
+            core::TensorShape::from_dims({rows, config.stack.hidden_size}), weights.weight.type), std::nullopt};
+        return modules::LinearModule({config.stack.hidden_size, rows, false,
+            config.lm_head_precision}).build(ctx, input, slice);
+    };
+    auto semantic = project(m.semantic_start, count);
+    auto eos = project(m.eos, 1);
+    return core::wrap_tensor(ggml_concat(ctx.ggml, semantic.tensor, eos.tensor, 0),
+        input.shape.with_last_dim(count + 1), GGML_TYPE_F32);
