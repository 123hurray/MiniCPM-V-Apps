+static std::vector<float> make_causal_mask(int n_keys, int n_queries, int n_past) {
+    const int   padded  = GGML_PAD(n_queries, GGML_KQ_MASK_PAD);
+    const float neg_inf = -std::numeric_limits<float>::infinity();
+
+    std::vector<float> mask(static_cast<size_t>(n_keys) * static_cast<size_t>(padded), neg_inf);
+    for (int q = 0; q < n_queries; ++q) {
+        const int last_visible_key = std::min(n_keys - 1, n_past + q);
+        for (int k = 0; k <= last_visible_key; ++k) {
+            mask[static_cast<size_t>(k) + static_cast<size_t>(q) * static_cast<size_t>(n_keys)] = 0.0f;
+        }
+    }
+    return mask;
